<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />

<footer class="site-footer safe-bottom" aria-label="UNIT-X Footer">
    <div class="site-footer__container">

        <div class="site-footer__social" aria-label="UNIT-X Social Links">
            <a class="footer-icon footer-icon--yt" href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
            <a class="footer-icon footer-icon--fb" href="#" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
            <a class="footer-icon footer-icon--ig" href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <a class="footer-icon footer-icon--x"  href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
            <a class="footer-icon footer-icon--dc" href="#" aria-label="Discord"><i class="fa-brands fa-discord"></i></a>
        </div>

        <div class="site-footer__title">UNIT-X</div>

        <div class="site-footer__meta">
            본 프로젝트는 학습/포트폴리오 목적의 팀 프로젝트입니다.<br/>
            문의: unitx.team@example.com &nbsp;•&nbsp; 운영시간: 10:00 ~ 18:00
        </div>

        <div class="site-footer__links" aria-label="Footer Links">
            <a href="#">이용약관</a>
            <a href="#">개인정보처리방침</a>
            <a href="#">고객센터</a>
            <a href="${ctx}/boards/report">버그/리포트</a>
        </div>

    </div>
</footer>
