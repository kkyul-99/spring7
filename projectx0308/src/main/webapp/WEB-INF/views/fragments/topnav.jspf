
<style>
.nav-link--admin {
    background: linear-gradient(110deg, rgba(233,176,196,0.18), rgba(186,198,220,0.14)) !important;
    border: 1px solid rgba(233,176,196,0.30) !important;
    color: rgba(255,255,255,0.85) !important;
}
.nav-link--admin:hover {
    background: linear-gradient(110deg, rgba(233,176,196,0.30), rgba(186,198,220,0.25)) !important;
    border-color: rgba(233,176,196,0.55) !important;
    color: #fff !important;
    box-shadow: 0 0 18px rgba(233,176,196,0.25);
}
</style>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<c:set var="uri" value="${pageContext.request.requestURI}" />

<nav class="premium-glass fixed top-0 left-0 right-0 z-50">
    <div class="container mx-auto px-6 flex items-center" style="height: var(--nav-h);">

        <!-- 왼쪽: 로고 -->
        <div class="flex items-center shrink-0 mr-8">
            <a href="${ctx}/main" class="nav-brand" aria-label="UNIT-X">
                <img src="${ctx}/images/unitx-logo.png" alt="UNIT-X" />
            </a>
        </div>

        <!-- 가운데: 메뉴 -->
        <div class="hidden lg:flex flex-1 justify-center">
            <ul class="flex items-center gap-6 font-semibold text-sm tracking-wide">
                <li>
                    <a href="${ctx}/boards/notice" class="nav-link ${fn:contains(uri, '/boards/notice') ? 'nav-link--active' : ''}">
                        <i class="fas fa-bullhorn"></i>NOTICE
                    </a>
                </li>
                <li>
                    <a href="${ctx}/guide" class="nav-link ${fn:contains(uri, '/guide') ? 'nav-link--active' : ''}">
                        <i class="fas fa-circle-info"></i>GUIDE
                    </a>
                </li>
                <li>
                    <a href="${ctx}/trainees" class="nav-link ${fn:contains(uri, '/trainees') ? 'nav-link--active' : ''}">
                        <i class="fas fa-star"></i>IDOLS
                    </a>
                </li>
                <li>
                    <a href="${ctx}/boards/free" class="nav-link ${fn:contains(uri, '/boards/free') ? 'nav-link--active' : ''}">
                        <i class="fas fa-comments"></i>BOARD
                    </a>
                </li>
                <li>
                    <a href="${ctx}/boards/report" class="nav-link ${fn:contains(uri, '/boards/report') ? 'nav-link--active' : ''}">
                        <i class="fas fa-bug"></i>REPORT
                    </a>
                </li>
            </ul>
        </div>

        <!-- 오른쪽: 로그인 정보 -->
        <div class="hidden lg:flex items-center justify-end shrink-0 gap-3 ml-8">
            <c:choose>
                <c:when test="${not empty sessionScope.LOGIN_MEMBER}">
                    <div class="flex items-center gap-3 flex-nowrap">
                        <button onclick="openMypageModal()" class="mypage-trigger">
                            <span class="mypage-trigger__avatar"><i class="fas fa-user"></i></span>
                            <span class="mypage-trigger__name"><c:out value="${empty sessionScope.LOGIN_MEMBER.nickname ? sessionScope.LOGIN_MEMBER.mname : sessionScope.LOGIN_MEMBER.nickname}"/></span>
                            <i class="fas fa-chevron-down mypage-trigger__chevron"></i>
                        </button>
                        <form action="${ctx}/logout" method="post" class="m-0 shrink-0">
                            <button type="submit" class="nav-link nav-link--compact whitespace-nowrap text-sm">
                                <i class="fas fa-right-from-bracket"></i>LOG OUT
                            </button>
                        </form>
                        <a href="${ctx}/admin" class="nav-link nav-link--compact nav-link--admin whitespace-nowrap text-sm">
                            <i class="fas fa-gauge-high"></i>ADMIN
                        </a>
                    </div>
                </c:when>
                <c:otherwise>
                    <a href="${ctx}/login"  class="nav-link nav-link--compact text-sm ${fn:contains(uri, '/login')  ? 'nav-link--active' : ''}">LOG IN</a>
                    <a href="${ctx}/signup" class="nav-link nav-link--compact text-sm ${fn:contains(uri, '/signup') ? 'nav-link--active' : ''}">SIGN UP</a>
                </c:otherwise>
            </c:choose>
        </div>

    </div>
</nav>

<%-- ═══ 마이페이지 모달 ═══ --%>
<c:if test="${not empty sessionScope.LOGIN_MEMBER}">
<style>
.mypage-trigger {
    position:relative; z-index:10;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.12);
    cursor:pointer;
    font-family:"Orbitron",sans-serif; font-size:10px; font-weight:700;
    letter-spacing:0.12em; color:rgba(255,255,255,0.75);
    display:flex; align-items:center; gap:7px;
    white-space:nowrap; padding:6px 12px 6px 7px;
    border-radius:999px;
    transition: color 200ms ease, background 200ms ease,
                border-color 200ms ease, box-shadow 200ms ease,
                transform 200ms cubic-bezier(.22,1.4,.46,.98);
    overflow:hidden;
}
/* 호버 배경 글로우 */
.mypage-trigger::before {
    content:""; position:absolute; inset:0; border-radius:999px;
    background:linear-gradient(110deg,
        rgba(233,176,196,0.18) 0%,
        rgba(203,186,216,0.12) 50%,
        rgba(186,198,220,0.18) 100%);
    opacity:0; transition:opacity 220ms ease;
}
.mypage-trigger:hover {
    color:#fff;
    border-color:rgba(233,176,196,0.45);
    box-shadow:0 0 14px rgba(233,176,196,0.20), 0 2px 8px rgba(0,0,0,0.25);
    transform:translateY(-1px);
}
.mypage-trigger:hover::before { opacity:1; }
.mypage-trigger:active { transform:translateY(0); }

/* 아바타 원형 아이콘 */
.mypage-trigger__avatar {
    position:relative; z-index:1;
    width:20px; height:20px; border-radius:50%;
    background:linear-gradient(135deg, rgba(233,176,196,0.70), rgba(186,198,220,0.70));
    display:flex; align-items:center; justify-content:center;
    font-size:8px; color:#fff; flex-shrink:0;
}
/* 이름 - Orbitron 대신 부드러운 폰트 */
.mypage-trigger__name {
    position:relative; z-index:1;
    font-family:"Noto Sans KR", "Apple SD Gothic Neo", sans-serif;
    font-size:12px; font-weight:600; letter-spacing:0.04em;
}
/* 화살표 */
.mypage-trigger__chevron {
    position:relative; z-index:1;
    font-size:7px; opacity:0.50;
    transition:transform 250ms cubic-bezier(.22,1.4,.46,.98), opacity 200ms ease;
}
.mypage-trigger:hover .mypage-trigger__chevron {
    transform:rotate(180deg); opacity:0.85;
}

/* 오버레이 */
.mp-overlay {
    position:fixed; inset:0; z-index:9999;
    background:rgba(2,1,8,0); backdrop-filter:blur(0px);
    display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none;
    transition:opacity 350ms ease, background 350ms ease, backdrop-filter 350ms ease;
}
.mp-overlay.show {
    opacity:1; pointer-events:auto;
    background:rgba(2,1,8,0.80); backdrop-filter:blur(22px) saturate(1.4);
}

/* 모달 */
.mp-modal {
    position:relative; width:min(440px,93vw);
    border-radius:28px; overflow:hidden;
    background:linear-gradient(160deg,rgba(16,8,36,0.98),rgba(7,3,20,0.99));
    border:1px solid rgba(255,255,255,0.10);
    box-shadow:0 0 0 1px rgba(255,255,255,0.05) inset,
               0 60px 120px rgba(0,0,0,0.90),
               0 0 60px rgba(233,176,196,0.08);
    transform:translateY(60px) scale(0.85);
    transition:transform 480ms cubic-bezier(.22,1.4,.46,.98);
    max-height:90vh; overflow-y:auto;
}
.mp-overlay.show .mp-modal { transform:translateY(0) scale(1); }

/* 상단 그라디언트 바 */
.mp-topbar {
    height:4px;
    background:linear-gradient(90deg,rgb(233,176,196),rgb(203,186,216),rgb(186,198,220));
}

/* 닫기 */
.mp-close {
    position:absolute; top:16px; right:16px;
    width:30px; height:30px; border-radius:50%;
    background:rgba(255,255,255,0.07); border:1px solid rgba(255,255,255,0.13);
    color:rgba(255,255,255,0.50); font-size:11px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    transition:all 220ms cubic-bezier(.22,1.4,.46,.98);
}
.mp-close:hover { background:rgba(255,255,255,0.17); color:#fff; transform:scale(1.15) rotate(90deg); }

.mp-body { padding:28px 28px 24px; }

/* 환영 */
.mp-welcome { text-align:center; margin-bottom:24px; }
.mp-welcome__name {
    font-family:"Orbitron",sans-serif;
    font-size:clamp(16px,4vw,22px); font-weight:900;
    background:linear-gradient(110deg,#fff 0%,#f472b6 40%,#c084fc 60%,#60a5fa 80%,#fff 100%);
    background-size:260%; -webkit-background-clip:text; background-clip:text;
    -webkit-text-fill-color:transparent;
    animation:mpShimmer 3.5s ease infinite alternate;
    margin-bottom:3px;
}
@keyframes mpShimmer { from{background-position:0%} to{background-position:100%} }
.mp-welcome__sub {
    font-family:"Orbitron",sans-serif; font-size:8px;
    letter-spacing:0.30em; color:rgba(255,255,255,0.25);
}

/* 아바타 */
.mp-avatar-wrap { display:flex; flex-direction:column; align-items:center; margin-bottom:22px; }
.mp-avatar {
    position:relative; width:88px; height:88px; border-radius:50%;
    overflow:hidden;
    border:3px solid rgba(233,176,196,0.45);
    box-shadow:0 0 28px rgba(233,176,196,0.22), 0 0 0 7px rgba(233,176,196,0.06);
    cursor:pointer;
    transition:box-shadow 250ms ease, transform 250ms ease;
}
.mp-avatar:hover {
    box-shadow:0 0 42px rgba(233,176,196,0.55), 0 0 0 9px rgba(233,176,196,0.11);
    transform:scale(1.05);
}
.mp-avatar img { width:100%; height:100%; object-fit:cover; }
.mp-avatar__placeholder {
    width:100%; height:100%;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,rgba(233,176,196,0.14),rgba(186,198,220,0.14));
    font-size:36px; color:rgba(255,255,255,0.22);
}
.mp-avatar__cam {
    position:absolute; inset:0; background:rgba(0,0,0,0.48);
    display:flex; align-items:center; justify-content:center;
    opacity:0; transition:opacity 200ms ease; font-size:20px; color:#fff;
}
.mp-avatar:hover .mp-avatar__cam { opacity:1; }
.mp-avatar__hint { margin-top:7px; font-size:10px; color:rgba(255,255,255,0.25); letter-spacing:0.10em; }

/* 정보 행 */
.mp-info { display:flex; flex-direction:column; gap:9px; margin-bottom:20px; }
.mp-info-row {
    display:flex; align-items:center; gap:12px;
    background:rgba(255,255,255,0.045);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:13px; padding:11px 15px;
}
.mp-info-icon {
    width:28px; height:28px; border-radius:9px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:12px;
    background:linear-gradient(135deg,rgba(233,176,196,0.18),rgba(186,198,220,0.12));
    color:rgba(233,176,196,0.85);
}
.mp-info-label {
    font-family:"Orbitron",sans-serif; font-size:7px;
    letter-spacing:0.25em; color:rgba(255,255,255,0.28); margin-bottom:3px;
}
.mp-info-value { font-size:13px; font-weight:700; color:rgba(255,255,255,0.90); }

/* 구분선 */
.mp-divider { height:1px; margin:18px 0; background:linear-gradient(90deg,rgba(233,176,196,0.20),transparent 80%); }

/* 버튼 */
.mp-actions { display:flex; flex-direction:column; gap:8px; }
.mp-btn {
    width:100%; padding:13px; border-radius:13px;
    font-family:"Orbitron",sans-serif; font-size:9px; font-weight:700; letter-spacing:0.20em;
    cursor:pointer; border:1px solid; display:flex; align-items:center; justify-content:center; gap:8px;
    transition:all 220ms cubic-bezier(.22,1.4,.46,.98);
}
.mp-btn--primary {
    background:linear-gradient(110deg,rgba(233,176,196,0.16),rgba(186,198,220,0.12));
    border-color:rgba(233,176,196,0.32); color:rgba(255,255,255,0.85);
}
.mp-btn--primary:hover {
    background:linear-gradient(110deg,rgba(233,176,196,0.28),rgba(186,198,220,0.22));
    border-color:rgba(233,176,196,0.60); color:#fff;
    box-shadow:0 0 20px rgba(233,176,196,0.18); transform:translateY(-2px);
}
.mp-btn--danger {
    background:rgba(248,113,113,0.06); border-color:rgba(248,113,113,0.22); color:rgba(248,113,113,0.70);
}
.mp-btn--danger:hover {
    background:rgba(248,113,113,0.15); border-color:rgba(248,113,113,0.50); color:rgba(248,113,113,1);
    transform:translateY(-2px);
}

/* 파티클 */
.mp-sparkle {
    position:absolute; border-radius:50%; pointer-events:none;
    animation:mpSpark 2.8s ease-in-out infinite; opacity:0;
}
@keyframes mpSpark {
    0%,100%{ opacity:0; transform:scale(0.3) translateY(0); }
    50%    { opacity:1; transform:scale(1.6) translateY(-9px); }
}
</style>

<%-- ═══ 모달 DOM ═══ --%>
<div class="mp-overlay" id="mp-overlay" onclick="if(event.target===this)closeMypageModal()">
  <div class="mp-modal" id="mp-modal">
    <div class="mp-topbar"></div>

    <%-- 파티클 --%>
    <span class="mp-sparkle" style="width:4px;height:4px;top:10%;left:88%;background:rgba(233,176,196,0.9);box-shadow:0 0 6px rgba(233,176,196,1);animation-delay:0s;"></span>
    <span class="mp-sparkle" style="width:3px;height:3px;top:7%;left:12%;background:rgba(186,198,220,0.85);box-shadow:0 0 5px rgba(186,198,220,1);animation-delay:1.0s;"></span>
    <span class="mp-sparkle" style="width:5px;height:5px;top:20%;left:93%;background:rgba(255,255,255,0.8);box-shadow:0 0 7px #fff;animation-delay:0.5s;"></span>
    <span class="mp-sparkle" style="width:3px;height:3px;top:4%;left:53%;background:rgba(203,186,216,0.9);box-shadow:0 0 5px rgba(203,186,216,1);animation-delay:1.7s;"></span>

    <button class="mp-close" onclick="closeMypageModal()"><i class="fas fa-times"></i></button>

    <div class="mp-body">
      <div class="mp-welcome">
        <div class="mp-welcome__name" id="mp-welcome-name">
          <c:out value="${empty sessionScope.LOGIN_MEMBER.nickname ? sessionScope.LOGIN_MEMBER.mname : sessionScope.LOGIN_MEMBER.nickname}"/>님, 환영합니다 ✨
        </div>
        <div class="mp-welcome__sub">MY PROFILE</div>
      </div>

      <%-- 아바타 업로드 (AJAX - 페이지 리로드 없음) --%>
      <input type="file" id="mp-avatarInput" name="file" accept="image/*"
             style="display:none;" onchange="uploadAvatar(this);" />
      <div class="mp-avatar-wrap">
        <div class="mp-avatar" onclick="document.getElementById('mp-avatarInput').click();">
          <div id="mp-avatar-inner">
            <div class="mp-avatar__placeholder"><i class="fas fa-user"></i></div>
          </div>
          <div class="mp-avatar__cam"><i class="fas fa-camera"></i></div>
        </div>
        <div class="mp-avatar__hint" id="mp-avatar-hint">클릭하여 이미지 변경</div>
      </div>

      <%-- 통계 미니 카드 --%>
      <div id="mp-stat-row" style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:18px;">
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:10px 8px;text-align:center;position:relative;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,rgb(233,176,196),rgb(203,186,216));"></div>
          <div id="mp-stat-plays" style="font-family:'Orbitron',sans-serif;font-size:18px;font-weight:900;color:#fff;">-</div>
          <div style="font-size:8px;letter-spacing:0.16em;color:rgba(255,255,255,0.30);font-family:'Orbitron',sans-serif;">PLAYS</div>
        </div>
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:10px 8px;text-align:center;position:relative;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,rgba(134,239,172,0.8),rgb(203,186,216));"></div>
          <div id="mp-stat-fin" style="font-family:'Orbitron',sans-serif;font-size:18px;font-weight:900;color:#fff;">-</div>
          <div style="font-size:8px;letter-spacing:0.16em;color:rgba(255,255,255,0.30);font-family:'Orbitron',sans-serif;">DONE</div>
        </div>
        <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:12px;padding:10px 8px;text-align:center;position:relative;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,rgb(203,186,216),rgb(186,198,220));"></div>
          <div id="mp-stat-date" style="font-family:'Orbitron',sans-serif;font-size:13px;font-weight:900;color:#fff;">-</div>
          <div style="font-size:8px;letter-spacing:0.16em;color:rgba(255,255,255,0.30);font-family:'Orbitron',sans-serif;">JOIN</div>
        </div>
      </div>

      <%-- 정보 --%>
      <div class="mp-info">
        <div class="mp-info-row">
          <div class="mp-info-icon"><i class="fas fa-at"></i></div>
          <div>
            <div class="mp-info-label">NICKNAME</div>
            <div class="mp-info-value" id="mp-val-nick"><c:out value="${sessionScope.LOGIN_MEMBER.nickname}"/></div>
          </div>
        </div>
        <div class="mp-info-row">
          <div class="mp-info-icon"><i class="fas fa-id-badge"></i></div>
          <div>
            <div class="mp-info-label">ID</div>
            <div class="mp-info-value"><c:out value="${sessionScope.LOGIN_MEMBER.mid}"/></div>
          </div>
        </div>
        <div class="mp-info-row">
          <div class="mp-info-icon"><i class="fas fa-envelope"></i></div>
          <div style="min-width:0;">
            <div class="mp-info-label">EMAIL</div>
            <div class="mp-info-value" id="mp-val-email" style="font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">-</div>
          </div>
        </div>
      </div>

      <div class="mp-divider"></div>

      <%-- 최근 게임 기록 --%>
      <div id="mp-recent-games" style="display:none;margin-bottom:16px;">
        <div style="font-family:'Orbitron',sans-serif;font-size:8px;letter-spacing:0.24em;color:rgba(255,255,255,0.28);margin-bottom:10px;">✦ &nbsp; RECENT GAMES</div>
        <div id="mp-games-list"></div>
      </div>

      <div class="mp-divider" id="mp-games-divider" style="display:none;"></div>

      <div class="mp-actions">
        <button class="mp-btn mp-btn--primary" onclick="(function(){
          try{
            var ac=new(window.AudioContext||window.webkitAudioContext)();
            function b(f1,f2,s,d,v){var o=ac.createOscillator(),g=ac.createGain();o.connect(g);g.connect(ac.destination);o.type='sine';o.frequency.setValueAtTime(f1,ac.currentTime+s);o.frequency.exponentialRampToValueAtTime(f2,ac.currentTime+s+d);g.gain.setValueAtTime(0,ac.currentTime+s);g.gain.linearRampToValueAtTime(v,ac.currentTime+s+0.02);g.gain.exponentialRampToValueAtTime(0.001,ac.currentTime+s+d);o.start(ac.currentTime+s);o.stop(ac.currentTime+s+d+0.05);}
            b(300,680,0,0.22,0.25);b(680,420,0.20,0.30,0.18);b(900,1100,0.10,0.12,0.06);
          }catch(e){}
          setTimeout(function(){ closeMypageModal(); window.location.href='${ctx}/mypage'; }, 420);
        })();">
          <i class="fas fa-user-pen"></i> 상세 정보 · 수정하기
        </button>
        <button class="mp-btn mp-btn--danger"
                onclick="closeMypageModal(); document.getElementById('mp-logout-form').submit();">
          <i class="fas fa-right-from-bracket"></i> 로그아웃
        </button>
      </div>
    </div>
  </div>
</div>
<form id="mp-logout-form" action="${ctx}/logout" method="post" style="display:none;"></form>

<script>
(function(){
  var ctx = '${pageContext.request.contextPath}';

  /* ── 우와~ 소리 (Web Audio API) ── */
  function playWow() {
    try {
      var ac = new (window.AudioContext || window.webkitAudioContext)();
      /* 글리산도 상승 + 하강 = "우와~" 느낌 */
      function beep(freq1, freq2, start, dur, vol, type) {
        var osc  = ac.createOscillator();
        var gain = ac.createGain();
        osc.connect(gain); gain.connect(ac.destination);
        osc.type = type || 'sine';
        osc.frequency.setValueAtTime(freq1, ac.currentTime + start);
        osc.frequency.exponentialRampToValueAtTime(freq2, ac.currentTime + start + dur);
        gain.gain.setValueAtTime(0, ac.currentTime + start);
        gain.gain.linearRampToValueAtTime(vol, ac.currentTime + start + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + start + dur);
        osc.start(ac.currentTime + start);
        osc.stop(ac.currentTime + start + dur + 0.05);
      }
      /* 우↗ (상승) */
      beep(300, 680, 0.00, 0.22, 0.25, 'sine');
      beep(300, 680, 0.00, 0.22, 0.10, 'triangle');
      /* 와↘ (하강 + 여운) */
      beep(680, 420, 0.20, 0.30, 0.18, 'sine');
      beep(680, 420, 0.20, 0.30, 0.07, 'triangle');
      /* 반짝 하이라이트 */
      beep(900, 1100, 0.10, 0.12, 0.06, 'sine');
      beep(1100, 900, 0.22, 0.10, 0.04, 'sine');
    } catch(e){}
  }

  /* ── 그룹타입 한글 변환 ── */
  function groupLabel(type) {
    if (type === 'MALE')   return '♂ 남자 그룹';
    if (type === 'FEMALE') return '♀ 여자 그룹';
    return '⚥ 혼성 그룹';
  }

  /* ── 프로필 + 통계 로드 ── */
  function loadProfile() {
    fetch(ctx + '/mypage/info')
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if (!d) return;

        // 프로필 이미지
        if (d.profileImage) setAvatarImg(ctx + '/profile-image/' + d.profileImage);

        // 이메일
        var emailEl = document.getElementById('mp-val-email');
        if (emailEl && d.email) emailEl.textContent = d.email;

        // 통계
        var playsEl = document.getElementById('mp-stat-plays');
        var finEl   = document.getElementById('mp-stat-fin');
        var dateEl  = document.getElementById('mp-stat-date');
        if (playsEl) playsEl.textContent = d.totalPlays != null ? d.totalPlays : 0;
        if (finEl)   finEl.textContent   = d.finishedPlays != null ? d.finishedPlays : 0;
        if (dateEl)  dateEl.textContent  = d.createdAt || '-';

        // 최근 게임 2개
        if (d.recentGames && d.recentGames.length > 0) {
          var listEl = document.getElementById('mp-games-list');
          var html = '';
          d.recentGames.forEach(function(g) {
            var isFinished = g.phase === 'FINISHED';
            var spanStyle = 'font-family:Orbitron,sans-serif;font-size:9px;letter-spacing:0.12em;padding:3px 10px;border-radius:999px;background:rgba(233,176,196,0.12);border:1px solid rgba(233,176,196,0.20);color:rgba(233,176,196,0.85);';
            var phaseColor = isFinished ? 'rgba(134,239,172,0.75)' : 'rgba(255,255,255,0.35)';
            var phaseText  = isFinished ? '✔ 완료' : g.phase;
            html += '<div style="background:rgba(0,0,0,0.22);border:1px solid rgba(255,255,255,0.07);border-radius:11px;padding:10px 13px;margin-bottom:7px;display:flex;align-items:center;justify-content:space-between;">'
                  + '<span style="' + spanStyle + '">' + groupLabel(g.groupType) + '</span>'
                  + '<span style="font-size:10px;color:' + phaseColor + ';">' + phaseText + '</span>'
                  + '</div>';
          });
          if (listEl) listEl.innerHTML = html;
          var section = document.getElementById('mp-recent-games');
          var divider = document.getElementById('mp-games-divider');
          if (section) section.style.display = 'block';
          if (divider) divider.style.display = 'block';
        }
      }).catch(function(){});
  }

  /* ── 아바타 이미지 교체 (모달 안에서 즉시 반영) ── */
  function setAvatarImg(src) {
    var inner = document.getElementById('mp-avatar-inner');
    if (!inner) return;
    var img = new Image();
    img.onload = function() {
      inner.innerHTML = '<img src="'+src+'" alt="프로필" '
        + 'style="width:100%;height:100%;object-fit:cover;border-radius:50%;">';
    };
    img.src = src;
  }

  /* ── AJAX 업로드 (페이지 리로드 없이 모달에서 즉시 변경) ── */
  window.uploadAvatar = function(input) {
    if (!input.files || !input.files[0]) return;
    var file = input.files[0];

    /* 미리보기 즉시 표시 (업로드 전에 로컬 URL로 먼저 보여줌) */
    var localUrl = URL.createObjectURL(file);
    setAvatarImg(localUrl);

    var hint = document.getElementById('mp-avatar-hint');
    if (hint) { hint.textContent = '업로드 중...'; hint.style.color = 'rgba(233,176,196,0.7)'; }

    var fd = new FormData();
    fd.append('file', file);

    fetch(ctx + '/mypage/profile-image/ajax', {
      method: 'POST',
      body: fd
    })
    .then(function(r){ return r.ok ? r.json() : Promise.reject(r.status); })
    .then(function(d){
      /* 서버 저장 완료 → 서버 URL로 교체 */
      setAvatarImg(ctx + '/profile-image/' + d.storedFilename);
      if (hint) { hint.textContent = '✔ 변경 완료!'; hint.style.color = 'rgba(134,239,172,0.9)'; }
      setTimeout(function(){
        if (hint) { hint.textContent = '클릭하여 이미지 변경'; hint.style.color = ''; }
      }, 2000);
    })
    .catch(function(){
      if (hint) { hint.textContent = '업로드 실패. 다시 시도해주세요.'; hint.style.color = 'rgba(248,113,113,0.9)'; }
    });
  };

  /* ── 모달 열기 ── */
  window.openMypageModal = function() {
    playWow();
    loadProfile();
    document.getElementById('mp-overlay').classList.add('show');
    document.body.style.overflow = 'hidden';
  };

  /* ── 모달 닫기 ── */
  window.closeMypageModal = function() {
    document.getElementById('mp-overlay').classList.remove('show');
    document.body.style.overflow = '';
  };

  /* ESC 닫기 */
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') closeMypageModal();
  });
})();
</script>
</c:if>

